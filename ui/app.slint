import { HorizontalBox, ListView, ScrollView, VerticalBox } from "std-widgets.slint";

export struct PoemRow {
    id: string,
    title: string,
    meta: string,
    snippet: string,
    tags: string,
    favorite_label: string,
    favorite: bool,
}

export struct DiscoveryResultRow {
    id: string,
    title: string,
    author: string,
    dynasty: string,
    snippet: string,
    snippet_centered: bool,
    reason: string,
    relevance: string,
}

component TintedIcon inherits Image {
    in property <brush> tint: #5D5348;

    colorize: root.tint;
    image-fit: contain;
}

component SidebarPrimaryAction inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 52px;
    border-radius: 14px;
    background: touch.pressed ? #E2D4BF : (touch.has-hover ? #EFE4D4 : #E6DDCF);
    border-color: touch.pressed ? #9D6D1F : (touch.has-hover ? #A97D37 : #B78A3D);
    border-width: 1px;
    clip: true;

    TintedIcon {
        x: 16px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        source: @image-url("../assets/icons/discover.svg");
        tint: touch.pressed ? #7A591F : #8B6B3F;
    }

    Text {
        text: parent.text;
        x: 52px;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        color: #1F1B16;
        font-size: 16px;
        font-weight: 700;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SidebarNavItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    in property <string> caption;
    callback clicked();

    height: 56px;
    border-radius: 14px;
    background: root.active ? #EFE7DB : (touch.pressed ? #EEE5D9 : (touch.has-hover ? #F6F0E8 : #FBF8F2));
    border-color: root.active ? #B78A3D : (touch.has-hover ? #D5C1A7 : #E8DED1);
    border-width: 1px;
    clip: true;

    TintedIcon {
        x: 16px;
        y: 18px;
        width: 20px;
        height: 20px;
        source: parent.icon;
        tint: root.active ? #8B6B3F : (touch.has-hover ? #5D5348 : #6C6257);
    }

    Text {
        text: parent.text;
        x: 52px;
        y: 10px;
        color: root.active ? #1F1B16 : (touch.has-hover ? #1F1B16 : #2B241F);
        font-size: 16px;
        font-weight: root.active ? 700 : 600;
        opacity: 1;
    }

    Text {
        text: parent.caption;
        x: 52px;
        y: 30px;
        color: #8B8074;
        font-size: 11px;
        opacity: 1;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    height: 34px;
    border-radius: 17px;
    background: root.active ? #E8DED1 : (touch.pressed ? #EEE4D7 : (touch.has-hover ? #F6F0E8 : #FBF8F2));
    border-color: root.active ? #B78A3D : (touch.has-hover ? #CDB79A : #DDD4C8);
    border-width: 1px;

    label := Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.active ? #1F1B16 : (touch.has-hover ? #1F1B16 : #2B241F);
        font-size: 13px;
        font-weight: root.active ? 700 : 600;
        opacity: 1;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component CardIconAction inherits Rectangle {
    in property <image> icon;
    in property <brush> icon-color: touch.has-hover ? #3A342E : #5D5348;
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: 19px;
    background: touch.pressed ? #EEE4D7 : (touch.has-hover ? #F3EDE4 : #FBF8F2);
    border-color: touch.pressed ? #B78A3D : (touch.has-hover ? #C9B292 : #DDD4C8);
    border-width: 1px;

    TintedIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        tint: root.icon-color;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    out property <bool> has-focus: editor.has-focus;
    callback accepted();
    forward-focus: editor;

    border-radius: 18px;
    background: #FBF8F2;
    border-color: editor.has-focus ? #B78A3D : #DDD4C8;
    border-width: editor.has-focus ? 2px : 1px;
    clip: true;

    TintedIcon {
        x: 18px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        source: @image-url("../assets/icons/search.svg");
        tint: editor.has-focus ? #8B6B3F : #8B8074;
    }

    editor := TextInput {
        x: 52px;
        y: 0;
        width: parent.width - 72px;
        height: parent.height;
        text <=> root.text;
        color: #2B241F;
        selection-background-color: #D8C7AD;
        selection-foreground-color: #1F1B16;
        single-line: true;
        wrap: no-wrap;
        vertical-alignment: center;
        accepted => { root.accepted(); }
    }

    if editor.text == "" : Text {
        x: 52px;
        y: 0;
        width: parent.width - 72px;
        height: parent.height;
        text: root.placeholder-text;
        color: #8B8074;
        vertical-alignment: center;
        font-size: 13px;
        wrap: no-wrap;
        overflow: elide;
    }

    TouchArea {
        clicked => { editor.focus(); }
    }
}

component InputField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    out property <bool> has-focus: editor.has-focus;
    callback accepted();
    forward-focus: editor;

    border-radius: 14px;
    background: #FBF8F2;
    border-color: editor.has-focus ? #B78A3D : #DDD4C8;
    border-width: editor.has-focus ? 2px : 1px;
    clip: true;

    editor := TextInput {
        x: 14px;
        y: 0;
        width: parent.width - 28px;
        height: parent.height;
        text <=> root.text;
        color: #2B241F;
        selection-background-color: #D8C7AD;
        selection-foreground-color: #1F1B16;
        single-line: true;
        wrap: no-wrap;
        vertical-alignment: center;
        accepted => { root.accepted(); }
    }

    if editor.text == "" : Text {
        x: 14px;
        y: 0;
        width: parent.width - 28px;
        height: parent.height;
        text: root.placeholder-text;
        color: #A29588;
        vertical-alignment: center;
        font-size: 13px;
        wrap: no-wrap;
        overflow: elide;
    }

    TouchArea {
        clicked => { editor.focus(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    border-radius: 12px;
    background: !root.enabled ? #F5EFE5 : (touch.pressed ? #E8DED1 : (touch.has-hover ? #F3EDE4 : #FBF8F2));
    border-color: touch.pressed ? #B78A3D : (touch.has-hover ? #C9B292 : #DDD4C8);
    border-width: 1px;
    opacity: root.enabled ? 1 : 0.6;

    Text {
        text: parent.text;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: #2B241F;
        font-size: 14px;
        font-weight: 700;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();

    background: transparent;

    Rectangle {
        x: 0;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: root.checked ? #CBE4FF : #FBF8F2;
        border-color: root.checked ? #78AEE8 : #CFC4B8;
        border-width: 1px;

        if root.checked : TintedIcon {
            x: 5px;
            y: 5px;
            width: 14px;
            height: 14px;
            source: @image-url("../assets/icons/check.svg");
            tint: #1F1B16;
        }
    }

    Text {
        x: 36px;
        y: 0;
        width: parent.width - 36px;
        height: parent.height;
        text: root.text;
        color: #5D5348;
        vertical-alignment: center;
        font-size: 13px;
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component PoemListCard inherits Rectangle {
    in property <string> title;
    in property <string> meta;
    in property <string> snippet;
    in property <bool> favorite;
    in property <bool> selected;
    callback clicked();

    height: 118px;
    border-radius: 16px;
    background: root.selected ? #F0E9DE : (touch.pressed ? #EFE5D8 : (touch.has-hover ? #F6F0E8 : #FBF8F2));
    border-color: root.selected ? #B78A3D : (touch.has-hover ? #D0BA9C : #DDD4C8);
    border-width: 1px;

    Text {
        text: parent.title;
        x: 18px;
        y: 16px;
        color: touch.has-hover && !root.selected ? #16120E : #1F1B16;
        font-size: 17px;
        font-weight: 700;
    }

    Text {
        text: parent.meta;
        x: 18px;
        y: 44px;
        color: touch.has-hover && !root.selected ? #5D5348 : #6C6257;
        font-size: 12px;
    }

    Text {
        text: parent.snippet;
        x: 18px;
        y: 66px;
        width: parent.width - 70px;
        color: touch.has-hover && !root.selected ? #3F3831 : #4E463E;
        font-size: 13px;
    }

    TintedIcon {
        x: parent.width - 38px;
        y: 18px;
        width: 18px;
        height: 18px;
        source: parent.favorite ? @image-url("../assets/icons/favorite-filled.svg") : @image-url("../assets/icons/favorite-outline.svg");
        tint: parent.favorite ? #B45309 : #B8ADA0;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component DiscoveryResultCard inherits Rectangle {
    in property <string> title;
    in property <string> author;
    in property <string> dynasty;
    in property <string> snippet;
    in property <bool> snippet_centered;
    in property <string> reason;
    in property <string> relevance;
    callback add-clicked();

    height: self.preferred-height;
    preferred-height: reasonText.y + reasonText.preferred-height + 18px;
    min-height: self.preferred-height;
    border-radius: 18px;
    background: touch.pressed ? #F2E8D9 : (touch.has-hover ? #FFFDF8 : #FCFAF6);
    border-color: touch.pressed ? #C7A97A : (touch.has-hover ? #D0BA9C : #E4D9CC);
    border-width: 1px;
    clip: true;
    drop-shadow-blur: touch.has-hover ? 14px : 8px;
    drop-shadow-color: touch.has-hover ? rgba(72, 54, 32, 0.12) : rgba(72, 54, 32, 0.08);

    touch := TouchArea {}

    titleText := Text {
        x: 18px;
        y: 18px;
        width: parent.width - 110px;
        text: root.title;
        color: #1F1B16;
        font-size: 17px;
        font-weight: 700;
        wrap: word-wrap;
    }

    metaText := Text {
        x: 18px;
        y: titleText.y + titleText.preferred-height + 6px;
        width: parent.width - 110px;
        text: root.author + (root.dynasty == "" ? "" : (" · " + root.dynasty));
        color: #6C6257;
        font-size: 12px;
        wrap: word-wrap;
    }

    relevanceBadge := Rectangle {
        x: parent.width - 84px;
        y: 18px;
        width: 60px;
        height: 26px;
        border-radius: 13px;
        background: #F4ECDD;
        border-color: #E2D2B5;
        border-width: 1px;

        Text {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.relevance;
            color: #8B6B3F;
            font-size: 12px;
            font-weight: 700;
        }
    }

    addAction := CardIconAction {
        x: parent.width - 56px;
        y: 72px;
        width: 34px;
        height: 34px;
        icon: @image-url("../assets/icons/plus.svg");
        icon-color: #8B6B3F;
        clicked => { root.add-clicked(); }
    }

    poemBody := Rectangle {
        x: 18px;
        y: metaText.y + metaText.preferred-height + 14px;
        width: parent.width - 110px;
        height: max(88px, poemText.preferred-height + 24px);
        border-radius: 14px;
        background: touch.has-hover ? #FBF5EA : #F8F1E5;
        border-color: touch.has-hover ? #E0CFB3 : #E8DDCE;
        border-width: 1px;
        clip: true;

        poemText := Text {
            x: 14px;
            y: root.snippet_centered ? (parent.height - self.preferred-height) / 2 : 12px;
            width: parent.width - 28px;
            text: root.snippet;
            color: #433A31;
            font-size: 14px;
            font-weight: 500;
            horizontal-alignment: root.snippet_centered ? center : left;
            vertical-alignment: root.snippet_centered ? center : top;
            wrap: word-wrap;
        }
    }

    reasonText := Text {
        x: 18px;
        y: poemBody.y + poemBody.height + 12px;
        width: parent.width - 36px;
        height: self.preferred-height;
        text: root.reason;
        color: #6C6257;
        font-size: 12px;
        wrap: word-wrap;
    }
}

export component AppWindow inherits Window {
    title: "诗词收藏";
    width: 1200px;
    height: 800px;
    background: #F7F3EC;

    blurSink := FocusScope {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        focus-on-click: false;
    }

    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clicked => { blurSink.focus(); }
    }

    in-out property <[PoemRow]> poem_rows;
    in-out property <[DiscoveryResultRow]> discovery_rows;
    in-out property <string> section_title;
    in-out property <string> poem_count;
    in-out property <string> selected_poem_id;
    in-out property <string> selected_title;
    in-out property <string> selected_meta;
    in-out property <string> selected_tags;
    in-out property <string> selected_content;
    in-out property <bool> selected_favorite;
    in-out property <string> analysis_text;
    in-out property <string> ai_mode_label;
    in-out property <bool> ai_busy;
    in-out property <string> local_search_query;
    in-out property <string> discovery_query;
    in-out property <bool> discovery_busy;
    in-out property <string> discovery_status;
    in-out property <string> toast_message;
    in-out property <bool> toast_visible;
    in-out property <string> ai_base_url;
    in-out property <string> ai_model;
    in-out property <bool> allow_file_fallback;
    in-out property <string> secret_warning;

    property <string> sidebar_view: "home";
    property <string> inspector_view: "detail";
    in-out property <bool> discovery_popup_open: false;
    property <bool> discovery_status_visible: root.discovery_busy || !root.discovery_status.is-empty;

    callback select_filter(string);
    callback select_poem(string);
    callback toggle_favorite(string);
    callback run_local_search(string);
    callback run_discovery_search(string);
    callback import_discovery(string);
    callback request_appreciation(string);
    callback dismiss_toast();
    callback save_ai_settings(string, string, string, bool);
    callback clear_ai_key();

    mainLayer := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;
        opacity: root.discovery_popup_open ? 0.94 : 1;
        animate opacity { duration: 140ms; easing: ease-in-out; }

    Rectangle {
        x: 16px;
        y: 16px;
        width: 220px;
        height: parent.height - 32px;
        border-radius: 22px;
        background: #FBF8F2;
        border-color: #DDD4C8;
        border-width: 1px;

        discoverButton := SidebarPrimaryAction {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            text: "发现新诗词";
            clicked => {
                root.sidebar_view = "home";
                root.inspector_view = "detail";
                root.select_filter("recommended");
                root.discovery_popup_open = true;
                discoverySearchInput.focus();
            }
        }

        homeNav := SidebarNavItem {
            x: 16px;
            y: 88px;
            width: parent.width - 32px;
            icon: @image-url("../assets/icons/home.svg");
            text: "首页";
            caption: "浏览当前诗库";
            active: root.sidebar_view == "home";
            clicked => {
                root.sidebar_view = "home";
                root.inspector_view = "detail";
                root.select_filter("recommended");
            }
        }

        favoritesNav := SidebarNavItem {
            x: 16px;
            y: 152px;
            width: parent.width - 32px;
            icon: @image-url("../assets/icons/favorite-filled.svg");
            text: "收藏夹";
            caption: "查看已收藏诗词";
            active: root.sidebar_view == "favorites";
            clicked => {
                root.sidebar_view = "favorites";
                root.inspector_view = "detail";
                root.select_filter("favorites");
            }
        }

        aboutNav := SidebarNavItem {
            x: 16px;
            y: 216px;
            width: parent.width - 32px;
            icon: @image-url("../assets/icons/about.svg");
            text: "关于";
            caption: "查看应用说明";
            active: root.sidebar_view == "about";
            clicked => {
                root.sidebar_view = "about";
                root.inspector_view = "about";
            }
        }

        Rectangle {
            x: 16px;
            y: parent.height - 152px;
            width: parent.width - 32px;
            height: 1px;
            background: #E8DED1;
        }

        themeNav := SidebarNavItem {
            x: 16px;
            y: parent.height - 136px;
            width: parent.width - 32px;
            icon: @image-url("../assets/icons/theme.svg");
            text: "主题设置";
            caption: "纸感 / 现代排版";
            active: root.inspector_view == "theme";
            clicked => {
                root.inspector_view = "theme";
            }
        }

        settingsNav := SidebarNavItem {
            x: 16px;
            y: parent.height - 72px;
            width: parent.width - 32px;
            icon: @image-url("../assets/icons/settings.svg");
            text: "AI 设置";
            caption: root.ai_model;
            active: root.inspector_view == "settings";
            clicked => {
                root.inspector_view = "settings";
            }
        }
    }

    Rectangle {
        x: 252px;
        y: 16px;
        width: 540px;
        height: parent.height - 32px;
        background: transparent;

        searchInput := SearchField {
            x: 0;
            y: 0;
            width: parent.width;
            height: 56px;
            text <=> root.local_search_query;
            placeholder-text: "搜索本地诗词：标题、作者、内容";
            accepted => { root.run_local_search(root.local_search_query); }
        }

        Text {
            x: 0;
            y: 76px;
            text: root.section_title;
            color: #1F1B16;
            font-size: 26px;
            font-weight: 700;
        }

        allChip := FilterChip {
            x: 0;
            y: 118px;
            width: 86px;
            text: "全部";
            active: root.section_title == "首页" || root.section_title == "推荐诗库" || root.section_title == "本地搜索结果";
            clicked => {
                root.sidebar_view = "home";
                root.inspector_view = "detail";
                root.local_search_query = "";
                root.run_local_search("");
                root.select_filter("recommended");
            }
        }

        tangChip := FilterChip {
            x: 98px;
            y: 118px;
            width: 96px;
            text: "唐诗精选";
            active: root.section_title == "唐诗精选";
            clicked => {
                root.sidebar_view = "home";
                root.inspector_view = "detail";
                root.local_search_query = "";
                root.run_local_search("");
                root.select_filter("tang");
            }
        }

        songChip := FilterChip {
            x: 206px;
            y: 118px;
            width: 96px;
            text: "宋词清单";
            active: root.section_title == "宋词清单";
            clicked => {
                root.sidebar_view = "home";
                root.inspector_view = "detail";
                root.local_search_query = "";
                root.run_local_search("");
                root.select_filter("song");
            }
        }

        randomChip := FilterChip {
            x: 314px;
            y: 118px;
            width: 96px;
            text: "随机精选";
            active: root.section_title == "随机精选";
            clicked => {
                root.sidebar_view = "home";
                root.inspector_view = "detail";
                root.local_search_query = "";
                root.run_local_search("");
                root.select_filter("random");
            }
        }

        Text {
            x: parent.width - 170px;
            y: 126px;
            width: 170px;
            horizontal-alignment: right;
            text: root.poem_count;
            color: #8B8074;
            font-size: 12px;
        }

        Rectangle {
            x: 0;
            y: 168px;
            width: parent.width;
            height: parent.height - 168px;
            border-radius: 22px;
            background: #FBF8F2;
            border-color: #DDD4C8;
            border-width: 1px;
            clip: true;

            ListView {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                height: parent.height - 28px;
                horizontal-scrollbar-policy: always-off;

                for poem[index] in root.poem_rows : Rectangle {
                    width: parent.width;
                    height: 130px;
                    background: transparent;

                    PoemListCard {
                        width: parent.width;
                        title: poem.title;
                        meta: poem.meta;
                        snippet: poem.snippet;
                        favorite: poem.favorite;
                        selected: poem.id == root.selected_poem_id;
                        clicked => {
                            root.inspector_view = "detail";
                            root.select_poem(poem.id);
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: 808px;
        y: 16px;
        width: 376px;
        height: parent.height - 32px;
        border-radius: 22px;
        background: #FBF8F2;
        border-color: #DDD4C8;
        border-width: 1px;

        if root.inspector_view == "detail" : ScrollView {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            VerticalBox {
                width: parent.width;
                padding: 20px;
                spacing: 18px;
                alignment: start;

                VerticalBox {
                    spacing: 6px;
                    vertical-stretch: 0;
                    alignment: start;

                    HorizontalBox {
                        spacing: 12px;
                        vertical-stretch: 0;

                        TintedIcon {
                            width: 22px;
                            height: 22px;
                            vertical-stretch: 0;
                            source: @image-url("../assets/icons/poem-detail.svg");
                            tint: #8B8074;
                        }

                        Text {
                            text: root.selected_title;
                            color: #1F1B16;
                            font-size: 20px;
                            font-weight: 700;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-stretch: 0;
                        }

                        favAction := CardIconAction {
                            width: 38px;
                            height: 38px;
                            icon: root.selected_favorite ? @image-url("../assets/icons/favorite-filled.svg") : @image-url("../assets/icons/favorite-outline.svg");
                            icon-color: root.selected_favorite ? #B45309 : #8B8074;
                            horizontal-stretch: 0;
                            vertical-stretch: 0;
                            clicked => { root.toggle_favorite(root.selected_poem_id); }
                        }

                        aiAction := CardIconAction {
                            width: 38px;
                            height: 38px;
                            icon: @image-url("../assets/icons/ai.svg");
                            icon-color: root.ai_busy ? #A29588 : #8B6B3F;
                            horizontal-stretch: 0;
                            vertical-stretch: 0;
                            clicked => {
                                if (!root.ai_busy) {
                                    root.request_appreciation(root.selected_poem_id);
                                }
                            }
                        }
                    }

                    Text {
                        text: root.selected_meta;
                        color: #6C6257;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-stretch: 0;
                    }

                    Text {
                        text: root.selected_tags;
                        color: #8B6B3F;
                        font-size: 12px;
                        wrap: word-wrap;
                        vertical-stretch: 0;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #E8DED1;
                    vertical-stretch: 0;
                }

                Text {
                    text: root.selected_content;
                    color: #1F1B16;
                    font-size: 18px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }

                Rectangle {
                    height: 1px;
                    background: #E8DED1;
                    vertical-stretch: 0;
                }

                if !root.analysis_text.is-empty : VerticalBox {
                    spacing: 18px;

                    Text {
                        text: "赏析";
                        color: #1F1B16;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-stretch: 0;
                    }

                    Text {
                        text: root.analysis_text;
                        color: #3A342E;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-stretch: 0;
                    }

                    Rectangle {
                        height: 1px;
                        background: #E8DED1;
                        vertical-stretch: 0;
                    }
                }

                Rectangle {
                    height: 4px;
                    background: transparent;
                    vertical-stretch: 0;
                }
            }
        }

        if root.inspector_view == "settings" : ScrollView {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            VerticalBox {
                width: parent.width;
                padding: 20px;
                spacing: 18px;

                Text {
                    text: "AI 设置";
                    color: #1F1B16;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-stretch: 0;
                }

                Text {
                    text: "当前模式：" + root.ai_mode_label;
                    color: #6C6257;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }

                if !root.secret_warning.is-empty : Text {
                    text: root.secret_warning;
                    color: #8B6B3F;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }

                VerticalBox {
                    spacing: 8px;

                    Text {
                        text: "Base URL";
                        color: #5D5348;
                        font-size: 12px;
                        vertical-stretch: 0;
                    }

                    baseInput := InputField {
                        height: 44px;
                        text <=> root.ai_base_url;
                        placeholder-text: "https://api.openai.com/v1";
                        vertical-stretch: 0;
                    }
                }

                VerticalBox {
                    spacing: 8px;

                    Text {
                        text: "Model";
                        color: #5D5348;
                        font-size: 12px;
                        vertical-stretch: 0;
                    }

                    modelInput := InputField {
                        height: 44px;
                        text <=> root.ai_model;
                        placeholder-text: "gpt-4.1-mini";
                        vertical-stretch: 0;
                    }
                }

                VerticalBox {
                    spacing: 8px;

                    Text {
                        text: "API Key";
                        color: #5D5348;
                        font-size: 12px;
                        vertical-stretch: 0;
                    }

                    keyInput := InputField {
                        height: 44px;
                        placeholder-text: "输入 API Key";
                        vertical-stretch: 0;
                    }
                }

                fallbackToggle := ToggleRow {
                    height: 28px;
                    text: "允许文件回退存储";
                    checked <=> root.allow_file_fallback;
                    vertical-stretch: 0;
                }

                HorizontalBox {
                    spacing: 12px;

                    saveButton := ActionButton {
                        width: 128px;
                        height: 44px;
                        text: "保存设置";
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        clicked => {
                            root.save_ai_settings(baseInput.text, modelInput.text, keyInput.text, root.allow_file_fallback);
                            keyInput.text = "";
                        }
                    }

                    clearButton := ActionButton {
                        width: 116px;
                        height: 44px;
                        text: "清除 Key";
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        clicked => { root.clear_ai_key(); }
                    }

                    Rectangle {
                        background: transparent;
                    }
                }

                Rectangle {
                    height: 4px;
                    background: transparent;
                    vertical-stretch: 0;
                }
            }
        }

        if root.inspector_view == "theme" : Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: transparent;

            Text {
                x: 20px;
                y: 22px;
                text: "主题设置";
                color: #1F1B16;
                font-size: 20px;
                font-weight: 700;
            }

                Text {
                    x: 20px;
                    y: 60px;
                    width: parent.width - 40px;
                    text: "当前为温暖纸感主题。";
                    color: #6C6257;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }

        if root.inspector_view == "about" : ScrollView {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            VerticalBox {
                width: parent.width;
                padding: 20px;
                spacing: 16px;

                Text {
                    text: "关于这款诗词桌面端";
                    color: #1F1B16;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-stretch: 0;
                }

                Text {
                    width: parent.width - 40px;
                    text: "以本地诗库为底，安静地浏览、收藏与阅读诗词。";
                    color: #6C6257;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
            }
        }
    }

    fab := Rectangle {
        x: parent.width - 70px;
        y: parent.height - 70px;
        width: 54px;
        height: 54px;
        border-radius: 27px;
        background: fabTouch.pressed ? #E2D4BF : (fabTouch.has-hover ? #EFE4D4 : #E6DDCF);
        border-color: fabTouch.pressed ? #9D6D1F : (fabTouch.has-hover ? #A97D37 : #B78A3D);
        border-width: 1px;

        Text {
            text: "+";
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: fabTouch.pressed ? #7A591F : #8B6B3F;
            font-size: 26px;
            font-weight: 700;
        }

        fabTouch := TouchArea {
            clicked => {
                if (!root.ai_busy) {
                    root.request_appreciation(root.selected_poem_id);
                }
            }
        }
    }

    }

    modalLayer := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        visible: root.discovery_popup_open;
        background: root.discovery_popup_open ? rgba(68, 54, 38, 0.18) : transparent;
        opacity: root.discovery_popup_open ? 1 : 0;
        animate opacity { duration: 140ms; easing: ease-in-out; }

        TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.discovery_popup_open;
            clicked => {
                root.discovery_popup_open = false;
                blurSink.focus();
            }
        }

        discoverPopup := Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.discovery_popup_open ? 86px : 104px;
            width: 600px;
            height: 560px;
            border-radius: 26px;
            background: #FCF8F1;
            border-color: #DACDBD;
            border-width: 1px;
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(56, 42, 27, 0.22);
            opacity: root.discovery_popup_open ? 1 : 0;
            animate y { duration: 160ms; easing: ease-out; }
            animate opacity { duration: 120ms; easing: ease-in-out; }

            TouchArea {
                width: parent.width;
                height: parent.height;
                enabled: root.discovery_popup_open;
            }

            Text {
                x: 40px;
                y: 36px;
                text: "发现新诗词";
                color: #1F1B16;
                font-size: 22px;
                font-weight: 700;
            }

            discoverySearchInput := SearchField {
                x: 40px;
                y: 76px;
                width: parent.width - 160px;
                height: 48px;
                text <=> root.discovery_query;
                placeholder-text: "输入关键词、片段或意境";
                accepted => { root.run_discovery_search(root.discovery_query); }
            }

            searchButton := ActionButton {
                x: parent.width - 108px;
                y: 76px;
                width: 68px;
                height: 48px;
                text: root.discovery_busy ? "搜索中" : "搜索";
                enabled: !root.discovery_busy;
                clicked => { root.run_discovery_search(root.discovery_query); }
            }

            if root.discovery_status_visible : Rectangle {
                x: 40px;
                y: 140px;
                width: parent.width - 80px;
                height: 38px;
                border-radius: 14px;
                background: #F7F1E7;
                border-width: 0px;

                if root.discovery_busy : Text {
                    x: 14px;
                    y: 0;
                    width: parent.width - 28px;
                    height: parent.height;
                    text: "AI 正在搜索最匹配的诗词…";
                    color: #8B6B3F;
                    font-size: 13px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                if !root.discovery_busy && !root.discovery_status.is-empty : Text {
                    x: 14px;
                    y: 0;
                    width: parent.width - 28px;
                    height: parent.height;
                    text: root.discovery_status;
                    color: #8B6B3F;
                    font-size: 13px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

            }

            Rectangle {
                x: 40px;
                y: root.discovery_status_visible ? 192px : 144px;
                width: parent.width - 80px;
                height: root.discovery_status_visible ? parent.height - 276px : parent.height - 228px;
                border-radius: 22px;
                background: #FDFBF7;
                border-width: 0px;
                clip: true;

                if !root.discovery_busy && root.discovery_rows.length == 0 : Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: "请输入关键词";
                    color: #9A8F82;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ListView {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    horizontal-scrollbar-policy: always-off;

                    for item[index] in root.discovery_rows : Rectangle {
                        width: parent.width;
                        height: card.preferred-height + 16px;
                        background: transparent;

                        card := DiscoveryResultCard {
                            x: 2px;
                            y: 4px;
                            width: parent.width - 4px;
                            title: item.title;
                            author: item.author;
                            dynasty: item.dynasty;
                            snippet: item.snippet;
                            snippet_centered: item.snippet_centered;
                            reason: item.reason;
                            relevance: item.relevance;
                            add-clicked => { root.import_discovery(item.id); }
                        }
                    }
                }
            }

            closeButton := ActionButton {
                x: parent.width - 112px;
                y: parent.height - 64px;
                width: 92px;
                height: 44px;
                text: "关闭";
                clicked => {
                    root.discovery_popup_open = false;
                    blurSink.focus();
                }
            }
        }
    }

    if root.toast_visible : Rectangle {
        x: parent.width - self.width - 24px;
        y: parent.height - 92px;
        width: 360px;
        height: 52px;
        border-radius: 18px;
        background: #2F261E;
        border-color: rgba(255, 248, 238, 0.18);
        border-width: 1px;
        drop-shadow-blur: 18px;
        drop-shadow-color: rgba(35, 24, 15, 0.28);
        opacity: root.toast_visible ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-in-out; }

        TintedIcon {
            x: 18px;
            y: 16px;
            width: 20px;
            height: 20px;
            source: @image-url("../assets/icons/check.svg");
            tint: #EADCC8;
        }

        Text {
            x: 50px;
            y: 0;
            width: parent.width - 76px;
            height: parent.height;
            text: root.toast_message;
            color: #FFF8ED;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        TouchArea {
            clicked => { root.dismiss_toast(); }
        }
    }
}
