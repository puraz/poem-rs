<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="poem-rs"
      Language="1033"
      Version="$(env.CargoVersion)"
      Manufacturer="poem-rs maintainers"
      UpgradeCode="DE96989B-5C96-4170-AB92-D2CD9CAC7721"
  >
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of poem-rs is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="poem-rs" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="poem-rs" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="6F831318-BD0B-493C-9B24-4E4DA7FD7E68">
        <File
            Id="PoemRsExe"
            Source="$(env.CargoTargetBinDir)\poem-rs.exe"
            KeyPath="yes"
        >
          <Shortcut
            Id="ApplicationStartMenuShortcut"
            Advertise="yes"
            Directory="ProgramMenuFolder"
            Name="poem-rs"
            Description="Desktop poetry library and AI-assisted appreciation"
            WorkingDirectory="INSTALLFOLDER"
          />
        </File>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
