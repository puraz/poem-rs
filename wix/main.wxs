<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="poem-rs"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="poem-rs maintainers"
      UpgradeCode="DE96989B-5C96-4170-AB92-D2CD9CAC7721"
  >
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64" />
    <Condition Message="poem-rs currently supports only 64-bit Windows.">VersionNT64</Condition>
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of poem-rs is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPPRODUCTICON" Value="PoemRsProductIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Icon Id="PoemRsProductIcon" SourceFile="assets\icons\app.ico" />
    <WixVariable Id="WixUILicenseRtf" Value="wix\license.rtf" />
    <UIRef Id="WixUI_InstallDir" />

    <Feature Id="MainApplication" Title="poem-rs" Level="1">
      <ComponentRef Id="ApplicationExecutableComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="poem-rs" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="poem-rs" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ApplicationExecutableComponent" Guid="6F831318-BD0B-493C-9B24-4E4DA7FD7E68" Win64="yes">
        <File Id="PoemRsExe" Source="$(var.CargoTargetBinDir)\poem-rs.exe" Checksum="yes" />
        <RegistryValue Root="HKCU" Key="Software\poem-rs" Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcutComponent" Guid="16DBE81A-C57B-4D4D-AF42-440F6B6420A6" Win64="yes">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="poem-rs"
          Description="Desktop poetry library and AI-assisted appreciation"
          Target="[INSTALLFOLDER]poem-rs.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="PoemRsProductIcon"
          IconIndex="0"
        />
        <Shortcut
          Id="ApplicationUninstallShortcut"
          Name="Uninstall poem-rs"
          Description="Remove poem-rs from this PC"
          Target="[SystemFolder]msiexec.exe"
          Arguments="/x [ProductCode]"
        />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\poem-rs" Name="StartMenuShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="AF6783C4-526A-493C-90AB-33030A88EB65" Win64="yes">
        <Shortcut
          Id="ApplicationDesktopShortcut"
          Name="poem-rs"
          Description="Desktop poetry library and AI-assisted appreciation"
          Target="[INSTALLFOLDER]poem-rs.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="PoemRsProductIcon"
          IconIndex="0"
        />
        <RegistryValue Root="HKCU" Key="Software\poem-rs" Name="DesktopShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
